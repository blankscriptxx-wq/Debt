# --- database -----------------------------------------------------------------
# Three roles, three pools. See packages/db/migrations/0001_platform_primitives.sql
# for why the separation is the security control rather than a convention.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=solvenda_dev
PGSSL=disable

PGUSER_APP=solvenda_app
PGPASSWORD_APP=dev_app_pw
PGUSER_PLATFORM=solvenda_platform
PGPASSWORD_PLATFORM=dev_platform_pw
PGUSER_OWNER=solvenda_owner
PGPASSWORD_OWNER=dev_owner_pw

# Only used by the audit tamper-detection test. Leave unset outside development.
PGUSER_SUPER=
PGPASSWORD_SUPER=

# --- AI -----------------------------------------------------------------------
# When unset, the platform uses the deterministic stub provider so the whole
# suite runs offline. No AI output is ever applied to a regulated field without
# a recorded human approval, with or without a key.
ANTHROPIC_API_KEY=
# Optional. The code defaults to claude-opus-5; setting it here would override
# that, so it is left commented rather than pinning a different model by accident.
# SOLVENDA_AI_MODEL=claude-opus-5

# --- development sign-in ------------------------------------------------------
# One-click sign-in buttons on every portal, using the seeded accounts. Off
# unless set. The second variable is additionally required when NODE_ENV is
# production - which includes `next start` and every Vercel deployment - because
# enabling this on a public deployment opens the portal to anyone with the URL.
SOLVENDA_DEMO_LOGIN=
SOLVENDA_DEMO_LOGIN_ALLOW_PRODUCTION=

# The public origin, used for canonical URLs and the sitemap. The portals are
# routes in the same application (/app, /portal, /control), not separate hosts.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
